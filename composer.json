{
    "name": "certificate-generator/certificate-generator-v7",
    "description": "Certificate Generator WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "CertificateGenerator\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^2.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.unit.xml.dist && phpunit",
        "test:unit": "phpunit -c phpunit.unit.xml.dist",
        "test:performance": "phpunit --group performance",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "zip": "powershell -ExecutionPolicy Bypass -File bin/build-zip.ps1"
    },
    "require": {
        "endroid/qr-code": "^6.0"
    }
}
